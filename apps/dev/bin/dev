#!/usr/bin/env bash
# bin/dev — dev 启动器入口（安装到 PATH 用）。
#
# **单一真源**：本脚本不自己拼启动命令，只执行 `app.yaml` 里那条 launch 的 `command`
# （`./sha.sh lab` / `./sha.sh staging`）—— 与 dev 面板的「启动」按钮完全同一个入口。
# 所以产物、数据根、DIY_ENV、DIY_LAUNCH 全部由 sha.sh 决定，这里不重复一遍。
#
# 用法：
#   dev                起窗口（缺省 lab）
#   dev app            同上
#   dev app lab        明确 lab 变体
#   dev app staging    预生产（prod 构建 + 隔离数据根 build/staging/home）
#   dev list           列出 app.yaml 里的 launch id
#   dev --help
#
# 产物：<包根>/build/app（与变体无关）。缺产物时下面会提示先 `./sha.sh build`。
set -euo pipefail

_realpath() {
  local src="$1" d
  while [ -h "$src" ]; do
    d="$(dirname "$src")"
    src="$(readlink "$src")"
    [[ "$src" != /* ]] && src="$d/$src"
  done
  cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd
}

APP_DIR="$(dirname "$(_realpath "$0")")"
APP_YAML="$APP_DIR/app.yaml"
MAIN="$APP_DIR/build/app/main/index.mjs"

usage() {
  sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'
}

# 读 app.yaml：`variants` 列 id，`launch_command <id>` 取 command
_yaml() {
  node -e "
    const { readFileSync } = require('node:fs');
    const { parse } = require('yaml');
    const [mode, id] = process.argv.slice(1);
    const doc = parse(readFileSync('$APP_YAML', 'utf-8'));
    const launches = doc?.launches ?? [];
    if (mode === 'list') {
      for (const item of launches) console.log(item.id);
      process.exit(0);
    }
    const hit = launches.find((item) => item.id === id);
    if (!hit) {
      console.error('app.yaml 里没有 launch \"' + id + '\"（有：' + launches.map((i) => i.id).join(', ') + '）');
      process.exit(1);
    }
    process.stdout.write(hit.command);
  " "$@"
}

run_app() {
  local variant="${1:-lab}"
  shift || true
  [ -f "$APP_YAML" ] || { echo "缺 app.yaml：$APP_YAML" >&2; exit 1; }
  # 缺产物就**先构建**，而不是让人再敲一遍命令：`dev` 是日常入口，它自己该补齐前提。
  # （仓根 `./sha.sh build` 只编 pkgs，不产出本 app 的 build/app —— 这点最容易踩。）
  if [ ! -f "$MAIN" ]; then
    echo "dev: 产物缺失，先构建（$APP_DIR/sha.sh build）…" >&2
    "$APP_DIR/sha.sh" build || { echo "dev: 构建失败" >&2; exit 1; }
  fi
  local command
  command="$(_yaml launch "$variant")"
  echo "dev: 执行 app.yaml 的 launch ${variant} —— ${command}（cwd=${APP_DIR}）"
  cd "$APP_DIR"
  # 环境由那条 command 自己决定（sha.sh 设 DIY_HOME / DIY_ENV / DIY_LAUNCH），这里只透传参数
  exec bash -lc "$command \"\$@\"" dev "$@"
}

case "${1:-}" in
  ""|app)
    shift || true
    run_app "${1:-lab}" "${@:2}"
    ;;
  list|ls)
    echo "可用变体（app.yaml 的 launch id，共用一份 build/app 产物）："
    _yaml list | sed 's/^/  /'
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    echo "未知子命令：$1" >&2
    usage >&2
    exit 1
    ;;
esac
