#!/usr/bin/env bash
# bin/dev — dev 启动器入口（npm 全局 / 安装到 PATH 用）。
#
# 用法：
#   dev                起窗口（缺省变体 lab）
#   dev app            同上
#   dev app lab        明确 lab 变体
#   dev app prod       跑 prod 产物
#   dev list           列出可用的变体（有产物的）
#   dev --help
#
# 产物：<包根>/build/app/main/index.mjs（**与变体无关**，一份产物两种跑法）
# 数据根：DIY_HOME，缺省 <包根>/build/<variant>/home（变体只影响运行空间）
set -euo pipefail

_realpath() {
  local src="$1" d
  while [ -h "$src" ]; do
    d="$(dirname "$src")"
    src="$(readlink "$src")"
    [[ "$src" != /* ]] && src="$d/$src"
  done
  cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd
}

APP_DIR="$(dirname "$(_realpath "$0")")"

usage() {
  sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'
}

# 变体是**运行空间**，不是产物目录：产物永远 build/app
variants() {
  printf '%s\n' lab prod
}

# 产物路径（与变体无关）
MAIN="$APP_DIR/build/app/main/index.mjs"

# electron 二进制定位：优先本包 node_modules，其次仓根
electron_bin() {
  local bin="$APP_DIR/node_modules/.bin/electron"
  [ -x "$bin" ] || bin="$APP_DIR/../../node_modules/.bin/electron"
  [ -x "$bin" ] || {
    echo "找不到 electron 二进制：先在 $APP_DIR 跑 npm install" >&2
    exit 1
  }
  echo "$bin"
}

run_app() {
  local variant="${1:-lab}"
  local main="$MAIN"
  if [ ! -f "$main" ]; then
    echo "dev 未构建：$main" >&2
    echo "先跑 ./sha.sh build（产物一份，lab / prod 共用）" >&2
    exit 1
  fi
  # 数据根：只在「外部已按启动器口径注入」时继承（有 DIY_LAUNCH），否则 shell 里残留的
  # 生产 DIY_HOME（~/.diy）会把 prod 实例带进真数据根
  local injected
  injected="${DIY_LAUNCH:+${DIY_HOME:-}}"
  export DIY_HOME="${injected:-$APP_DIR/build/$variant/home}"
  export DIY_VARIANT="$variant"
  # 变体 = app.yaml 里的 launch id：写进实例注册表，dev 启动器据此显示「已启动」
  export DIY_LAUNCH="${DIY_LAUNCH:-$variant}"
  # 变体只改运行空间：prod ⇒ production，其余 ⇒ development
  if [ "$variant" = "prod" ]; then export DIY_ENV=production; else export DIY_ENV=development; fi
  [ -d "$DIY_HOME" ] || mkdir -p "$DIY_HOME"
  exec "$(electron_bin)" "$main" "${@:2}"
}

case "${1:-}" in
  ""|app)
    shift || true
    # `dev app` 或 `dev app <variant>`；`dev` 无参也走这里
    run_app "${1:-lab}" "${@:2}"
    ;;
  list|ls)
    echo "可用变体（同一份 build/app 产物）："
    variants | sed 's/^/  /'
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    echo "未知子命令：$1" >&2
    usage >&2
    exit 1
    ;;
esac
