#!/usr/bin/env bash
# bin/diy-dev — dev 启动器入口（npm 全局 / 安装到 PATH 用）。
#
# 用途：跑编译产物 build/<variant>/main/index.mjs（Electron 主进程）。
# 定位：跟随 symlink 解析包根（仿 bin/diy 的 app_realpath）。
#
#   diy-dev                起窗口（变体 lab，数据根 build/lab/home）
#   DIY_VARIANT=prod diy-dev 跑 prod 产物
#   diy-dev --help          本帮助
set -euo pipefail

_realpath() {
  local src="$1" d
  while [ -h "$src" ]; do
    d="$(dirname "$src")"
    src="$(readlink "$src")"
    [[ "$src" != /* ]] && src="$d/$src"
  done
  cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd
}

APP_DIR="$(dirname "$(_realpath "$0")")"
VARIANT="${DIY_VARIANT:-lab}"
MAIN="$APP_DIR/build/$VARIANT/main/index.mjs"

case "${1:-}" in
  -h|--help)
    sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
    ;;
esac

[[ -f "$MAIN" ]] || {
  echo "dev 未构建: $MAIN" >&2
  echo "先在 $APP_DIR 跑 ./sha.sh build（或 ./sha.sh lab 直接构建并启动）" >&2
  exit 1
}

# 数据根：优先 DIY_HOME，否则 build/<variant>/home（与 ./sha.sh lab 同一约定）
export DIY_HOME="${DIY_HOME:-$APP_DIR/build/$VARIANT/home}"
export DIY_VARIANT
[ -d "$DIY_HOME" ] || mkdir -p "$DIY_HOME"

# electron 二进制定位：优先本包的 node_modules，其次仓根
ELECTRON_BIN="$APP_DIR/node_modules/.bin/electron"
[ -x "$ELECTRON_BIN" ] || ELECTRON_BIN="$APP_DIR/../../node_modules/.bin/electron"
[ -x "$ELECTRON_BIN" ] || {
  echo "找不到 electron 二进制：先在 $APP_DIR 跑 npm install" >&2
  exit 1
}

exec "$ELECTRON_BIN" "$MAIN" "$@"
