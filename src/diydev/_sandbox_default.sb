(version 1)
(deny default)
(import "system.sb")

;; ============================================================
;; 基础系统权限
;; ============================================================
(allow process-exec)
(allow process-fork)
(allow signal (target same-sandbox))
(allow process-info* (target same-sandbox))
(allow pseudo-tty)
(allow file-read* file-write* file-ioctl (literal "/dev/ptmx"))
(allow file-read* file-write*
  (require-all (regex #"^/dev/ttys[0-9]+") (extension "com.apple.sandbox.pty")))
(allow file-ioctl (regex #"^/dev/ttys[0-9]+"))
(allow sysctl-read)
(allow iokit-open (iokit-registry-entry-class "RootDomainUserClient"))
(allow ipc-posix-sem)
(allow user-preference-read)
(allow file-read-metadata (subpath "/"))
(allow file-write-data (require-all (path "/dev/null") (vnode-type CHARACTER-DEVICE)))

;; ============================================================
;; 读白名单 — 只允许这些路径
;; ============================================================

;; 系统
(allow file-read* file-map-executable
  (subpath "/System")
  (subpath "/usr")
  (subpath "/bin")
  (subpath "/sbin")
  (subpath "/Library")
  (subpath "/private")
  (subpath "/dev"))

;; 工作目录（动态：当前目录 + --dir）
(allow file-read*
  (subpath "${WORKDIR}")
${WORKDIRS_READ})

;; 工具链配置
(allow file-read*
  (subpath "${HOME}/.pi")
  (subpath "${HOME}/.agents")
  (subpath "${HOME}/.bun")
  (subpath "${HOME}/.local")
  (subpath "${HOME}/bin")
  (literal "${HOME}/.gitconfig")
  (literal "${HOME}/.npmrc")
  (literal "${HOME}/.bashrc")
  (literal "${HOME}/.zshrc")
  (subpath "${HOME}/.config")
  (subpath "${HOME}/.cargo")
  (subpath "${HOME}/.ssh"))

;; ============================================================
;; 写白名单 — 只允许写这些路径
;; ============================================================
(allow file-read* file-write*
${WORKDIRS_WRITE}
  ;; 临时目录
  (subpath "/tmp")
  (subpath "/private/var/folders")
  ;; 用户缓存和工具状态
  (subpath "${HOME}/.cache")
  (subpath "${HOME}/.pi")
  (subpath "${HOME}/.agents")
  (subpath "${HOME}/.bun")
  (subpath "${HOME}/.local")
  (subpath "${HOME}/.config")
  (subpath "${HOME}/.cargo"))

${DENY_UNLINKS}

;; ============================================================
;; 网络
;; ============================================================
(allow network-outbound)
(allow network-inbound (local ip "localhost:*"))
(allow network-bind (local ip "*:*"))
(allow mach-lookup
  (global-name "com.apple.mDNSResponder")
  (global-name "com.apple.mDNSResponderHelper")
  (global-name "com.apple.SystemConfiguration.DNSConfiguration")
  (global-name "com.apple.SystemConfiguration.configd"))
