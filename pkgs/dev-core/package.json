{
  "name": "@diy-agent/dev-core",
  "version": "0.1.0",
  "private": true,
  "description": "dev 启动器的业务层：静态发现 + 运行时对账 + 启停动作（无 UI、无 Electron）",
  "files": [
    "src/"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./shared": {
      "types": "./src/shared.ts",
      "default": "./lib/shared.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "js-yaml": "^5.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
