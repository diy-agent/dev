{
  "name": "@diy-agent/dev-ref",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "src/",
    "lib/"
  ],
  "dependencies": {
    "@diy-agent/rpc": "file:../../../diy/pkgs.ts/core/rpc",
    "@diy-agent/time": "file:../../../diy/pkgs.ts/core/time",
    "js-yaml": "^5.5.0",
    "zod": "file:../../../diy/node_modules/zod"
  },
  "devDependencies": {
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.3"
  },
  "oxlint": {
    "rules": {
      "no-unused-vars": "warn",
      "no-console": "off",
      "@typescript-eslint/no-unused-vars": [
        "warn",
        {
          "argsIgnorePattern": "^_"
        }
      ]
    },
    "ignorePatterns": [
      "node_modules/"
    ]
  },
  "description": "diy-dev-ref — ref（源码镜像 / 仓库引用）能力库（v1 简化版）：diy.yaml 注册 + clone/pull/lock",
  "scripts": {
    "build": "vite build --config vite.lib.config.ts"
  },
  "author": "ccc <ccc@users.noreply.github.com>"
}
